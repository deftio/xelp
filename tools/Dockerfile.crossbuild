FROM --platform=linux/amd64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Use libc6-dev-i386 instead of gcc-multilib to avoid conflicts
# with cross-compiler packages (gcc-multilib conflicts with
# gcc-aarch64-linux-gnu on 22.04)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    clang \
    libc6-dev-i386 \
    lib32gcc-s1 \
    gcc-aarch64-linux-gnu \
    gcc-arm-none-eabi \
    gcc-msp430 \
    gcc-avr \
    gcc-m68hc1x \
    gcc-m68k-linux-gnu \
    gcc-powerpc-linux-gnu \
    gcc-riscv64-linux-gnu \
    gcc-riscv64-unknown-elf \
    gcc-xtensa-lx106 \
    picolibc-xtensa-lx106-elf \
    tcc \
    curl \
    xz-utils \
    sdcc \
    binutils \
    && rm -rf /var/lib/apt/lists/*

# Espressif unified Xtensa toolchain (ESP32, ESP32-S2, ESP32-S3)
# Not in Ubuntu repos; download prebuilt from Espressif's crosstool-NG releases.
RUN curl -sL https://github.com/espressif/crosstool-NG/releases/download/esp-15.2.0_20251204/xtensa-esp-elf-15.2.0_20251204-x86_64-linux-gnu.tar.xz \
    | tar -xJ -C /opt \
    && ln -s /opt/xtensa-esp-elf/bin/xtensa-esp-elf-* /usr/local/bin/

WORKDIR /xelp

COPY src/ src/
COPY tools/compactbuilds-docker.sh tools/compactbuilds-docker.sh

CMD ["/bin/bash", "/xelp/tools/compactbuilds-docker.sh"]
